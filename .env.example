# OPC UA Server connection
SERVER_IP=127.0.0.1:48010
OPCUA_USERNAME=
OPCUA_PASSWORD=

# Target folder in OPC UA namespace
TARGET_FOLDER=IEC_DATA

# Value generation defaults
LOW_VALUE=0
HIGH_VALUE=29696
INTERVAL_MIN=60
UPPER_SHIFT_TIME_SEC=0
LOWER_SHIFT_TIME_SEC=0
RANDOM_MODE=y

# Behaviour flags
RESET_DOUBLES=true
DEBUG=false
